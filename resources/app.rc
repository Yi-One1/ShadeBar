// 随影 ShadeBar — Win32 资源脚本（§4 #5）
//
// 由 crates/shadebar-app/build.rs 调用 SDK 的 rc.exe 编译为 .res，
// 再通过 cargo:rustc-link-arg 交给链接器。
//
// 版本号不写死在这里：build.rs 从 CARGO_PKG_VERSION 生成 OUT_DIR/sb_version.h，
// 本文件通过 /I 包含它。这样版本号只有 Cargo.toml 一个来源（FR-16 / A-16）。
//
// 故意不 #include <winver.h>：VERSIONINFO / ICON / RT_MANIFEST 都是资源语句关键字，
// 不依赖系统头文件，因此 rc.exe 无需 INCLUDE 环境变量即可编译（构建环境更少假设）。

#pragma code_page(65001)

#include "sb_version.h"

// ---- 图标：资源 ID 1（最低 ID 即 Explorer 显示的应用程序图标） ----
1 ICON "app.ico"

// ---- 应用程序清单：RT_MANIFEST = 24，ID 1 表示进程级清单 ----
1 24 "app.manifest"

// ---- 版本信息 ----
1 VERSIONINFO
 FILEVERSION     SB_VERSION_CSV
 PRODUCTVERSION  SB_VERSION_CSV
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L   // VOS_NT_WINDOWS32
 FILETYPE        0x1L       // VFT_APP
 FILESUBTYPE     0x0L       // VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0804 = zh-CN，04B0 = 1200 (Unicode)。中文优先，英文系统回退到 0409 表不存在时
        // 仍读本表，故 ProductName 用中英并列以保证任何语言的资源管理器里都可辨认。
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      SB_COMPANY_NAME
            VALUE "FileDescription",  SB_FILE_DESCRIPTION
            VALUE "FileVersion",      SB_VERSION_STR
            VALUE "InternalName",     SB_INTERNAL_NAME
            VALUE "LegalCopyright",   SB_LEGAL_COPYRIGHT
            VALUE "OriginalFilename", SB_ORIGINAL_FILENAME
            VALUE "ProductName",      SB_PRODUCT_NAME
            VALUE "ProductVersion",   SB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
