# 构建产物
/target/

# 载荷构建中间物（由 payload/build.sh 生成）
/payload/build/*.dll
/payload/build/*.log
/payload/build/*.obj
/payload/build/*.lib
/payload/build/*.exp
/payload/*.log

# 发布产物走 GitHub Releases，不提交 exe
/dist/*.exe
# build.ps1 每次打包都会重新生成的门禁对照产物
/dist/verify/
/dist/compare/
.screenshots/
.build-*.log

# 开发期探针：可用但含大量截图/二进制，不进仓库
/scratch/

# 本地配置与备份
*.json.bak
*.exe.tmp

# IDE / 工具
.vs/
.idea/
.vscode/
/workbuddy/
.workbuddy/
**/target/
*.pdb
*.ilk
*.obj
